---
title: Discover Indie Browser Games & AI Experiments
description: Find indie browser games, game-jam surprises and AI experiments. Explore the directory and play at the original source.
permalink: /
---
{# Homepage: one playable spotlight, other hosted games, editorial picks,
   interest navigation and a compact latest list. All content is static HTML. #}

{% extends 'base.njk' %}

{% set public_games = games | indexableGames %}
{% set hosted_games = public_games | hostedGames | sortByDateDesc %}
{% set directory_games = public_games | rejectHosted %}
{% set featured_games = directory_games | featuredOnly %}
{% set new_games = directory_games | sortByDateDesc | limit(12) %}

{% block jsonld %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "ArcadeBloom",
      "description": "{{ site.description }}",
      "url": "{{ site.url }}/",
      "publisher": { "@id": "{{ site.url }}/#org" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ site.url }}/search/?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "{{ site.url }}/#org",
      "name": "ArcadeBloom",
      "url": "{{ site.url }}/",
      "description": "A directory of indie browser games and AI experiments.",
      "logo": "{{ site.url }}/og-image.png"
    }
  ]
}
</script>
{% endblock %}

{% block content %}
{% set spotlight = hosted_games[0] %}
{% set picks = featured_games | sortByScreenshotThenDate | limit(4) %}
<div class="home-editorial">
    <section id="play-here" aria-labelledby="spotlight-title">
        <p class="home-intro">Independent browser games. Unexpected ideas. Something worth playing.</p>
        {% if spotlight %}
        <div class="home-spotlight">
            <div class="home-spotlight__copy">
                <p class="eyebrow">In the spotlight · Play on ArcadeBloom</p>
                <h1 id="spotlight-title">{{ spotlight.name }}</h1>
                <p class="home-spotlight__pitch">{{ spotlight.tagline }}</p>
                <a class="btn-primary" href="{{ spotlight | hostedPath }}">Play {{ spotlight.name }} <span aria-hidden="true">↗</span></a>
                <a class="home-detail-link" href="/game/{{ spotlight.slug }}/">How to play</a>
            </div>
            <a class="home-spotlight__visual" href="{{ spotlight | hostedPath }}" aria-label="Open {{ spotlight.name }}">
                {% set game = spotlight %}{% include 'home-game-art.njk' %}
            </a>
        </div>
        {% else %}
        <h1 id="spotlight-title" class="display-h1">Find something worth playing.</h1>
        {% endif %}
        {% if hosted_games.length > 1 %}
        <div class="home-section-heading home-section-heading--small">
            <h2>More to play here</h2><a href="/play/">All our games <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-local-grid">
            {% for game in hosted_games | slice(1, 4) %}
            <article class="home-local-game">
                <a class="home-local-game__art" href="{{ game | hostedPath }}" aria-label="Open {{ game.name }}">{% include 'home-game-art.njk' %}</a>
                <div>
                    <h3>{{ game.name }}</h3>
                    <p>{{ game.tagline }}</p>
                    <a class="btn-primary" href="{{ game | hostedPath }}">Play {{ game.name }} <span aria-hidden="true">↗</span></a>
                    <a class="home-detail-link" href="/game/{{ game.slug }}/">Details</a>
                </div>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    {% if picks.length %}
    <section id="picks" class="home-section" aria-labelledby="picks-title">
        <div class="home-section-heading">
            <div><h2 id="picks-title">Worth a look</h2><p>Independent games selected from across the web.</p></div>
            <a href="/featured/">All editor’s picks <span aria-hidden="true">→</span></a>
        </div>
        <div class="home-picks">
            {% for game in picks %}
            <a href="/game/{{ game.slug }}/" class="home-pick">
                {% if game.screenshots.length %}<img src="{{ game.screenshots[0] }}" alt="{{ game.name }} screenshot" loading="lazy" width="640" height="400">{% endif %}
                <div><p class="eyebrow">{{ (site.categories | findCat(game.category)).name }}</p><h3>{{ game.name }}</h3><p>{{ game.tagline }}</p><span class="home-pick__link">Meet the game <span aria-hidden="true">→</span></span></div>
            </a>
            {% endfor %}
        </div>
    </section>

    {% endif %}
    <section class="home-explore home-section" aria-labelledby="explore-title">
        <h2 id="explore-title">Follow your curiosity</h2>
        <nav aria-label="Explore games by interest">
            <a href="/ai-games/">AI games <span aria-hidden="true">↗</span></a>
            {% for cat in site.categories %}
            {% set count = public_games | whereEq('category', cat.slug) | length %}
            {% if count >= site.minGamesPerCategory %}
            <a href="/category/{{ cat.slug }}/">{{ cat.name }} <span aria-hidden="true">↗</span></a>
            {% else %}
            <a href="/search/?q={{ cat.slug }}">{{ cat.name }} <span aria-hidden="true">↗</span></a>
            {% endif %}
            {% endfor %}
        </nav>
    </section>

    <section class="home-section" aria-labelledby="latest-title">
        <div class="home-section-heading"><div><h2 id="latest-title">Just added</h2><p>Fresh discoveries for your next visit.</p></div><a href="/new/">All new arrivals <span aria-hidden="true">→</span></a></div>
        <div class="home-latest">
            {% for game in new_games | limit(6) %}
            <a href="/game/{{ game.slug }}/">
                <div><h3>{{ game.name }}</h3><p>{{ game.tagline }}</p></div>
                <span class="home-latest__category">{{ (site.categories | findCat(game.category)).name }}</span><span aria-hidden="true">↗</span>
            </a>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
